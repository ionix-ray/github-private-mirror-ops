{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samirparhi-dev/github-private-mirror-ops/registry.schema.json",
  "title": "synced-repos registry",
  "type": "object",
  "required": ["version", "defaults", "repos"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "strategy"],
      "properties": {
        "schedule": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["fast-forward"] }
      }
    },
    "repos": {
      "type": "array",
      "items": { "$ref": "#/$defs/repo" }
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "private", "branch", "paused"],
      "properties": {
        "upstream": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "private":  { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "branch":   { "type": "string", "minLength": 1 },
        "paused":   { "type": "boolean" },
        "pause_reason": { "type": "string" },
        "last_synced_sha":   { "type": "string" },
        "last_synced_at":    { "type": "string" },
        "last_synced_status": { "enum": ["", "ok", "skipped", "diverged", "failed", "paused"] },
        "last_upstream_sha": { "type": "string" },
        "last_validated_at": { "type": "string" },
        "upstream_default_branch": { "type": "string" },
        "upstream_archived": { "type": "boolean" },
        "upstream_pushed_at": { "type": "string" },
        "upstream_size_kb":  { "type": "integer", "minimum": 0 },
        "license_current_spdx": { "type": "string" },
        "license_current_name": { "type": "string" },
        "license_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "from_spdx", "to_spdx", "upstream_sha"],
            "properties": {
              "date":         { "type": "string" },
              "from_spdx":    { "type": "string" },
              "to_spdx":      { "type": "string" },
              "upstream_sha": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
