{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ionix-ray/github-private-mirror-ops/schemas/owners.schema.json",
  "title": "owners config (tracker/owners.json)",
  "description": "Config-driven mapping from a mirror target owner to the GitHub Actions secret + environment that holds its PAT. PR-owned. Editing this is how you add/change a mirror target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owners"],
  "properties": {
    "version": { "const": 1 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "secret", "environment"],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "secret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
