{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ionix-ray/github-private-mirror-ops/schemas/metadata-record.schema.json",
  "title": "metadata record (tracker/metadata/<key>.json)",
  "description": "Observed/derived state for one mirror, cached from GitHub + sync runs. BOT-owned: written only by workflows, never hand-edited and never touched by registration PRs. One file per mirror.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream", "private"],
  "properties": {
    "upstream": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "private": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },

    "upstream_state": { "enum": ["active", "archived", "deleted", "unknown"] },
    "forked_at": { "type": "string" },
    "last_synced_sha": { "type": "string" },
    "last_synced_at": { "type": "string" },
    "last_synced_status": { "enum": ["", "ok", "skipped", "diverged", "failed", "paused"] },
    "last_upstream_sha": { "type": "string" },
    "last_validated_at": { "type": "string" },
    "refreshed_at": { "type": "string" },

    "upstream_default_branch": { "type": "string" },
    "upstream_archived": { "type": "boolean" },
    "upstream_pushed_at": { "type": "string" },
    "upstream_size_kb": { "type": "integer", "minimum": 0 },

    "license_current_spdx": { "type": "string" },
    "license_current_name": { "type": "string" },
    "license_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "from_spdx", "to_spdx", "upstream_sha"],
        "properties": {
          "date": { "type": "string" },
          "from_spdx": { "type": "string" },
          "to_spdx": { "type": "string" },
          "upstream_sha": { "type": "string" }
        }
      }
    },

    "description": { "type": "string" },
    "homepage": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "language": { "type": "string" },
    "languages": { "type": "object", "additionalProperties": { "type": "integer" } },
    "stargazers_count": { "type": "integer", "minimum": 0 },
    "forks_count": { "type": "integer", "minimum": 0 },
    "open_issues_count": { "type": "integer", "minimum": 0 },
    "watchers_count": { "type": "integer", "minimum": 0 },
    "network_count": { "type": "integer", "minimum": 0 },
    "subscribers_count": { "type": "integer", "minimum": 0 },
    "is_template": { "type": "boolean" },
    "has_discussions": { "type": "boolean" },
    "has_wiki": { "type": "boolean" },
    "has_pages": { "type": "boolean" },
    "has_projects": { "type": "boolean" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
