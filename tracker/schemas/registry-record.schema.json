{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ionix-ray/github-private-mirror-ops/schemas/registry-record.schema.json",
  "title": "registry record (tracker/registry/<key>.json)",
  "description": "Declared INTENT for one mirror. Human/PR-owned. One file per mirror so registration is purely additive and never conflicts. Workflows/bots MUST NOT write these files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstream", "private", "branch", "paused"],
  "properties": {
    "upstream": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "private": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": { "type": "string", "minLength": 1 },
    "paused": { "type": "boolean" },
    "pause_reason": { "type": "string" }
  }
}
